<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>CVRComfortUI</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GameDir Condition="'$(GameDir)' == ''">$(CHILLOUTVR_DIR)</GameDir>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>

  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="MelonLoader"><HintPath>$(GameDir)\MelonLoader\net35\MelonLoader.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(GameDir)\MelonLoader\net35\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(GameDir)\MelonLoader\net35\Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameDir)\ChilloutVR_Data\Managed\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(GameDir)\ChilloutVR_Data\Managed\UnityEngine.AudioModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(GameDir)\ChilloutVR_Data\Managed\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(GameDir)\ChilloutVR_Data\Managed\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(GameDir)\ChilloutVR_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(GameDir)\ChilloutVR_Data\Managed\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(GameDir)\ChilloutVR_Data\Managed\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(GameDir)\ChilloutVR_Data\Managed\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(GameDir)\ChilloutVR_Data\Managed\Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Cohtml.Runtime"><HintPath>$(GameDir)\ChilloutVR_Data\Managed\Cohtml.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="cohtml.Net"><HintPath>$(GameDir)\ChilloutVR_Data\Managed\cohtml.Net.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(GameDir)\ChilloutVR_Data\Managed\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <EmbeddedResource Include="..\assets\comfort.js" LogicalName="ComfortUI.comfort.js" />
    <EmbeddedResource Include="..\assets\comfort.css" LogicalName="ComfortUI.comfort.css" />
    <EmbeddedResource Include="..\assets\settings-zh.json" LogicalName="ComfortUI.settings-zh.json" />
    <EmbeddedResource Include="..\assets\content-tools.js" LogicalName="ComfortUI.content-tools.js" />
    <EmbeddedResource Include="..\assets\camera-zh.json" LogicalName="ComfortUI.camera-zh.json" />
    <EmbeddedResource Include="..\assets\locales.json" LogicalName="ComfortUI.locales.json" />
    <EmbeddedResource Include="..\assets\native-bridge.js" LogicalName="ComfortUI.native-bridge.js" />
    <EmbeddedResource Include="..\assets\keyboard-core.js" LogicalName="ComfortUI.keyboard-core.js" />
    <EmbeddedResource Include="..\assets\keyboard-data.js" LogicalName="ComfortUI.keyboard-data.js" />
    <EmbeddedResource Include="..\assets\keyboard.js" LogicalName="ComfortUI.keyboard.js" />
  </ItemGroup>
  <Target Name="ValidateGameDir" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GameDir)\ChilloutVR.exe')" Text="Set GameDir to your own installed ChilloutVR directory." />
    <Error Condition="!Exists('$(GameDir)\MelonLoader\net35\MelonLoader.dll')" Text="Mono MelonLoader is required to build this mod." />
  </Target>
</Project>
